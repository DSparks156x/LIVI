// carpid's pages, filled from livi-ui's carpi_ui.rs. Built for the RNS-E knob at 800x480: rows
// of 60 px with 22 px text, a filled highlight on whatever has focus, the grid of the Data page
// and its editor, and a toast over everything. Colours are LIVI's theme, which follows
// `light.night` through the bridge.

import { Theme } from "../../livi-ui/ui/theme.slint";
import { Focus, FocusZone } from "../../livi-ui/ui/focus.slint";

export enum CarpiLayout { list, grid, panel }
export enum CarpiKind { section, info, route, button, toggle, choice, step }

export struct CarpiPill {
    label: string,
    active: bool,
    tab: bool,
    focus-at: int,
}

export struct CarpiRow {
    kind: CarpiKind,
    label: string,
    value: string,
    button: string,
    tag: string,
    dimmed: bool,
    alert: bool,
    checked: bool,
    mono: bool,
    focus-at: int,
    first: bool,
    last: bool,
}

export struct CarpiCell {
    label: string,
    value: string,
    unit: string,
    why: string,
    dim: bool,
    empty: bool,
    focus-at: int,
}

// Where a focus index is: line -1 the header, 0.. a grid line, -2 a row with `rows` plain rows
// and `sections` captions above it.
export struct CarpiSpot {
    line: int,
    rows: int,
    sections: int,
}

// A point in the light plot, both 0..1, y up.
export struct CarpiPoint {
    x: float,
    y: float,
}

export struct CarpiTick {
    at: float,
    label: string,
}

// Data panels: see livi-carpi-ui's panels.rs `PanelDraw`.
export struct CarpiMark {
    x: float,
    y: float,
    label: string,
}

export struct CarpiLine {
    path: string,
    color: int,
    label: string,
}

export struct CarpiItem {
    label: string,
    value: string,
    frac: float,
    on: bool,
    state: int,
}

export struct CarpiWidget {
    col: int,
    row: int,
    w: int,
    h: int,
    style: int,
    label: string,
    value: string,
    unit: string,
    sub: string,
    sub-hi: bool,
    value2: string,
    label2: string,
    state: int,
    stale: bool,
    frac: float,
    ticks-off: string,
    ticks-on: string,
    red-off: string,
    red-on: string,
    needle: string,
    peak: string,
    labels: [CarpiMark],
    segs: int,
    lit: int,
    warn-from: int,
    limit-from: int,
    lines: [CarpiLine],
    marks: [CarpiMark],
    items: [CarpiItem],
    focus-at: int,
    picked: bool,
}

export struct CarpiEmpty {
    col: int,
    row: int,
    focus-at: int,
}

export global CarpiState {
    in property <bool> flashing-mode;
    in property <CarpiLayout> layout;
    in property <string> title;
    in property <string> hint;
    in property <string> note;
    in property <bool> can-back;
    in property <[CarpiPill]> pills;
    in property <[CarpiRow]> rows;
    in property <[CarpiCell]> cells;
    in property <int> cols: 1;
    in property <bool> outlined;
    in property <[CarpiSpot]> spots;
    // A step row takes the knob's keys while it's held (when the knob and the D-pad send the
    // same keys).
    in property <bool> holding;
    // Shown over LIVI's Settings: the Car Integration tab's plot and picker.
    in property <bool> over-settings;
    // The light plot: curve as SVG path commands in a 1000x1000 box, y down.
    in property <bool> plot-shown;
    in property <string> plot-curve;
    in property <[CarpiPoint]> plot-learned;
    in property <[CarpiPoint]> plot-manual;
    in property <bool> plot-now-shown;
    in property <CarpiPoint> plot-now;
    in property <[CarpiTick]> plot-ticks;
    in property <string> plot-caption;
    // A Data panel: the page itself, or beside the rows.
    in property <bool> panel-shown;
    in property <int> panel-cols: 1;
    in property <int> panel-rows: 1;
    in property <[CarpiWidget]> panel-widgets;
    in property <[CarpiEmpty]> panel-empties;
    in property <int> panel-dots;
    in property <int> panel-at;
    in property <bool> panel-edit;
    in property <string> panel-hint;

    callback back();
    callback pill(int);
    callback row(int);
    callback cell(int);
    callback panel(int);
}

// 0 info, 1 warn, 2 error.
export global CarpiToast {
    in property <bool> shown;
    in property <string> text;
    in property <int> level;
}

global M {
    out property <length> pad-x: 16px;
    out property <length> header-h: 52px;
    out property <length> row-h: 60px;
    out property <length> caption-h: 40px;
    out property <length> font: 22px;
    out property <length> small: 18px;
    out property <length> title: 26px;
    out property <length> radius: 12px;
    out property <length> gap: 8px;
    out property <color> alert: Theme.dark ? #ff6b6b : #c62828;
    out property <color> on-focus: #ffffff;
}

component Chevron inherits Path {
    in property <bool> left;
    width: 12px;
    height: 20px;
    viewbox-width: 12;
    viewbox-height: 20;
    commands: root.left ? "M 10 2 L 2 10 L 10 18" : "M 2 2 L 10 10 L 2 18";
    fill: transparent;
    stroke-width: 2.5px;
}

component Check inherits Path {
    width: 22px;
    height: 22px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M 4 12.5 L 9.5 18 L 20 6.5";
    fill: transparent;
    stroke-width: 3px;
}

component Tag inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    height: 26px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    border-width: 1.5px;
    border-color: root.ink;
    t := Text {
        text: root.text;
        color: root.ink;
        font-size: 15px;
        font-weight: 500;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> focused;
    width: 56px;
    height: 32px;
    border-radius: 16px;
    background: root.on ? (root.focused ? #ffffff : Theme.primary) : (root.focused ? #ffffff55 : (Theme.dark ? Theme.track : #00000033));
    Rectangle {
        x: root.on ? parent.width - self.width - 4px : 4px;
        y: 4px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: root.on && root.focused ? Theme.highlight : #ffffff;
        animate x { duration: 120ms; }
    }
}

component Header inherits Rectangle {
    property <int> focus-index: Focus.zone == FocusZone.main ? Focus.main-index : -1;
    height: M.header-h;

    HorizontalLayout {
        spacing: 6px;
        if CarpiState.can-back: Rectangle {
            width: 30px;
            Chevron {
                x: 4px;
                left: true;
                stroke: Theme.text-secondary;
            }
            TouchArea {
                clicked => { CarpiState.back(); }
            }
        }
        if CarpiState.title != "": Text {
            text: CarpiState.title;
            color: Theme.text;
            font-size: M.title;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: CarpiState.pills.length == 0 ? 1 : 0;
            min-width: min(self.preferred-width, 160px);
        }
        if CarpiState.pills.length > 0: Rectangle { width: 10px; }
        for p[i] in CarpiState.pills: tab := Rectangle {
            property <bool> focused: root.focus-index == p.focus-at;
            y: (parent.height - self.height) / 2;
            height: 44px;
            width: label.preferred-width + 28px;
            border-radius: 10px;
            background: self.focused ? Theme.highlight : transparent;
            border-width: !p.tab && !self.focused ? 2px : 0;
            border-color: Theme.divider;
            label := Text {
                text: p.label;
                color: tab.focused ? M.on-focus : (p.active || !p.tab ? Theme.text : Theme.text-secondary);
                font-size: 20px;
                font-weight: p.active ? 700 : 500;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            if p.active && !tab.focused: Rectangle {
                y: tab.height - 5px;
                x: 12px;
                width: tab.width - 24px;
                height: 4px;
                border-radius: 2px;
                background: Theme.primary;
            }
            TouchArea {
                clicked => { CarpiState.pill(i); }
            }
        }
        Rectangle { horizontal-stretch: CarpiState.pills.length == 0 ? 0 : 1; }
        if CarpiState.hint != "": Text {
            text: CarpiState.hint;
            color: Theme.text-secondary;
            font-size: M.small;
            vertical-alignment: center;
        }
    }
}

component RowView inherits Rectangle {
    in property <CarpiRow> r;
    in property <bool> focused;
    callback pushed();

    property <color> ink: root.focused ? M.on-focus : (r.alert ? M.alert : (r.dimmed ? Theme.text-disabled : Theme.text));
    property <color> soft: root.focused ? #ffffffd9 : (r.alert ? M.alert : (r.dimmed ? Theme.text-disabled : Theme.text-secondary));
    property <bool> sided: r.kind == CarpiKind.choice || r.kind == CarpiKind.step;

    height: M.row-h;

    // The section's card, with dividers between rows.
    Rectangle {
        background: Theme.paper;
        border-top-left-radius: r.first ? M.radius : 0;
        border-top-right-radius: r.first ? M.radius : 0;
        border-bottom-left-radius: r.last ? M.radius : 0;
        border-bottom-right-radius: r.last ? M.radius : 0;
    }
    if !r.first: Rectangle {
        x: 18px;
        y: 0;
        width: parent.width - 36px;
        height: 1px;
        background: Theme.hairline;
    }
    if root.focused: Rectangle {
        border-radius: M.radius;
        background: Theme.highlight;
        border-width: CarpiState.holding && r.kind == CarpiKind.step ? 3px : 0;
        border-color: #ffffff;
    }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 16px;
        spacing: 12px;
        Text {
            text: r.label;
            color: root.ink;
            font-size: M.font;
            font-weight: 500;
            font-family: r.mono ? "monospace" : "Roboto";
            vertical-alignment: center;
            overflow: elide;
            min-width: min(self.preferred-width, 200px);
        }
        if r.tag != "": Tag {
            y: (parent.height - self.height) / 2;
            text: r.tag;
            ink: root.soft;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.sided: Chevron {
            y: (parent.height - self.height) / 2;
            left: true;
            stroke: root.focused ? M.on-focus : Theme.text-disabled;
        }
        if r.value != "": Text {
            text: r.value;
            color: root.sided ? root.ink : root.soft;
            font-size: M.font;
            font-weight: root.sided ? 500 : 400;
            font-family: r.mono ? "monospace" : "Roboto";
            vertical-alignment: center;
            horizontal-alignment: right;
            // Two lines fit the row: a long value (an update error) wraps instead of cutting off.
            wrap: word-wrap;
            overflow: elide;
        }
        if root.sided: Chevron {
            y: (parent.height - self.height) / 2;
            stroke: root.focused ? M.on-focus : Theme.text-disabled;
        }
        if r.kind == CarpiKind.route: Chevron {
            y: (parent.height - self.height) / 2;
            stroke: root.soft;
        }
        if r.kind == CarpiKind.toggle: Switch {
            y: (parent.height - self.height) / 2;
            on: r.checked;
            focused: root.focused;
        }
        if r.checked && r.kind == CarpiKind.info: Check {
            y: (parent.height - self.height) / 2;
            stroke: root.focused ? M.on-focus : Theme.primary;
        }
        if r.kind == CarpiKind.button && r.button != "": Rectangle {
            y: (parent.height - self.height) / 2;
            height: 40px;
            width: word.preferred-width + 30px;
            border-radius: 20px;
            background: root.focused ? #ffffff : transparent;
            border-width: root.focused ? 0 : 2px;
            border-color: r.alert ? M.alert : Theme.primary;
            word := Text {
                text: r.button;
                color: root.focused ? Theme.highlight : (r.alert ? M.alert : Theme.primary);
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }
    TouchArea {
        clicked => { root.pushed(); }
    }
}

component Tile inherits Rectangle {
    in property <CarpiCell> c;
    in property <bool> focused;
    in property <bool> outlined;
    in property <int> cols;
    callback pushed();

    property <length> label-px: root.cols >= 4 ? 19px : (root.cols == 3 ? 22px : 26px);
    // As big as the tile allows, smaller for long values so they fit beside the unit.
    property <length> room: root.width - 26px - (c.unit.character-count * 0.6 + 0.5) * root.label-px;
    property <length> value-px: min(root.height * 0.42, root.cols >= 4 ? 40px : (root.cols == 3 ? 56px : 80px), root.room / max(1, c.value.character-count * 0.58));
    property <color> ink: root.focused ? M.on-focus : Theme.text;
    property <color> soft: root.focused ? #ffffffd9 : Theme.text-secondary;

    border-radius: M.radius;
    background: root.focused ? Theme.highlight : (c.empty ? transparent : Theme.paper);
    border-width: root.outlined && !root.focused ? 2px : 0;
    border-color: c.empty ? Theme.divider : Theme.hairline;

    if !c.empty: VerticalLayout {
        padding-left: 14px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        opacity: c.dim && !root.focused ? 0.5 : 1;
        Text {
            text: c.label;
            color: root.soft;
            font-size: root.label-px;
            font-weight: 500;
            overflow: elide;
        }
        if c.why == "": HorizontalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            Text {
                text: c.value;
                color: root.ink;
                font-size: root.value-px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                horizontal-stretch: 1;
                text: c.unit;
                color: root.soft;
                font-size: root.label-px;
                vertical-alignment: center;
            }
        }
        if c.why != "": Text {
            vertical-stretch: 1;
            text: c.why;
            color: root.focused ? root.soft : Theme.text-disabled;
            font-size: root.label-px;
            vertical-alignment: center;
        }
    }
    if c.empty && root.outlined: Text {
        text: "Empty";
        color: root.focused ? M.on-focus : Theme.text-disabled;
        font-size: root.label-px;
    }
    TouchArea {
        clicked => { root.pushed(); }
    }
}

component Grid inherits Rectangle {
    in property <int> focus-index;
    property <int> n: CarpiState.cells.length;
    property <int> cols: max(1, CarpiState.cols);
    property <int> lines: max(1, ceil(n / cols));
    property <length> cw: (root.width - (cols - 1) * M.gap) / cols;
    property <length> ch: (root.height - (lines - 1) * M.gap) / lines;

    for c[i] in CarpiState.cells: Tile {
        x: mod(i, root.cols) * (root.cw + M.gap);
        y: floor(i / root.cols) * (root.ch + M.gap);
        width: root.cw;
        height: root.ch;
        c: c;
        cols: root.cols;
        outlined: CarpiState.outlined;
        focused: c.focus-at >= 0 && root.focus-index == c.focus-at;
        pushed => { CarpiState.cell(i); }
    }
}

// Ambient across on a log scale (ticks are raw sensor values), RNS-E panel % up.
component Plot inherits Rectangle {
    property <length> gutter: 46px;
    property <length> head: 12px;
    property <length> foot: 48px;
    property <length> pw: root.width - root.gutter - 12px;
    property <length> ph: root.height - root.head - root.foot;
    property <length> dot: 9px;

    border-radius: M.radius;
    background: Theme.paper;

    area := Rectangle {
        x: root.gutter;
        y: root.head;
        width: root.pw;
        height: root.ph;
        border-width: 1px;
        border-color: Theme.divider;

        for f in [0.25, 0.5, 0.75]: Rectangle {
            y: parent.height * (1 - f);
            width: parent.width;
            height: 1px;
            background: Theme.hairline;
        }
        if CarpiState.plot-curve != "": Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: CarpiState.plot-curve;
            stroke: Theme.primary;
            stroke-width: 3px;
            fill: transparent;
        }
        for p in CarpiState.plot-manual: Rectangle {
            x: p.x * parent.width - root.dot;
            y: (1 - p.y) * parent.height - root.dot;
            width: root.dot * 2;
            height: root.dot * 2;
            border-radius: root.dot;
            border-width: 2px;
            border-color: Theme.primary;
        }
        for p in CarpiState.plot-learned: Rectangle {
            x: p.x * parent.width - root.dot / 2;
            y: (1 - p.y) * parent.height - root.dot / 2;
            width: root.dot;
            height: root.dot;
            border-radius: root.dot / 2;
            background: Theme.text-secondary;
        }
        if CarpiState.plot-now-shown: Rectangle {
            x: CarpiState.plot-now.x * parent.width - root.dot;
            y: (1 - CarpiState.plot-now.y) * parent.height - root.dot;
            width: root.dot * 2;
            height: root.dot * 2;
            border-radius: root.dot;
            background: Theme.primary;
            border-width: 3px;
            border-color: Theme.paper;
        }
    }
    for t[i] in [{ f: 1.0, l: "100%" }, { f: 0.5, l: "50%" }, { f: 0.0, l: "0" }]: Text {
        x: 0;
        width: root.gutter - 6px;
        y: area.y + area.height * (1 - t.f) - self.height / 2;
        text: t.l;
        color: Theme.text-secondary;
        font-size: 15px;
        horizontal-alignment: right;
    }
    for t in CarpiState.plot-ticks: Text {
        x: area.x + t.at * area.width - 26px;
        width: 52px;
        y: area.y + area.height + 3px;
        text: t.label;
        color: Theme.text-secondary;
        font-size: 15px;
        horizontal-alignment: center;
    }
    Text {
        x: area.x;
        width: area.width;
        y: root.height - self.height - 6px;
        text: CarpiState.plot-caption;
        color: Theme.text-disabled;
        font-size: 15px;
        overflow: elide;
    }
}


// ---- Data panels (docs/PAGES.md 5c): LIVI's telemetry look, black space and hairlines ----

global P {
    out property <color> amber: #ffa726;
    out property <color> red: #f44336;
    out property <color> dim-tick: Theme.text.with-alpha(0.16);
    out property <color> label: Theme.text.with-alpha(0.5);
    out property <color> hair: Theme.text.with-alpha(0.09);
}

// The tiny spaced caption over a widget.
component Caption inherits Text {
    in property <length> u;
    font-size: max(11px, 13 * root.u);
    font-weight: 500;
    letter-spacing: 1.6 * root.u;
    color: P.label;
    overflow: elide;
}

component WidgetView inherits Rectangle {
    in property <CarpiWidget> w;
    in property <bool> focused;
    in property <bool> edit;
    // 1 for a 200 px tall cell.
    property <float> k: min(root.width / 1px / 200, root.height / 1px / 140);
    property <length> u: clamp(root.k, 0.7, 2.2) * 1px;
    property <color> ink: w.stale ? Theme.text-disabled : Theme.text;
    property <color> state-ink: w.state == 2 ? P.red : (w.state == 1 ? P.amber : root.ink);
    callback pushed();

    border-radius: root.edit ? 10px : 0;
    background: root.edit ? Theme.paper : transparent;
    border-width: root.focused || w.picked ? 3px : 0;
    border-color: Theme.primary;

    // Number: label, big numeral and unit, a second line.
    if w.style == 0: VerticalLayout {
        padding: 12 * root.u;
        alignment: center;
        spacing: 6 * root.u;
        Caption { u: root.u; text: w.label; }
        HorizontalLayout {
            spacing: 6 * root.u;
            alignment: start;
            num := Text {
                text: w.value;
                color: root.state-ink;
                font-size: min(root.height * 0.5, (root.width - 40px) / max(2, w.value.character-count + w.unit.character-count * 0.45) * 1.6);
                vertical-alignment: bottom;
            }
            Text {
                text: w.unit;
                color: P.label;
                font-size: max(13px, num.font-size * 0.36);
                vertical-alignment: bottom;
                y: parent.height - self.height - num.font-size * 0.12;
            }
        }
        if w.sub != "": Text {
            text: w.sub;
            color: w.sub-hi ? Theme.primary : P.label;
            font-size: max(12px, 15 * root.u);
            font-weight: 500;
        }
    }

    // Gauge: the tick arc, the numeral in the middle.
    if w.style == 1: Rectangle {
        property <length> side: min(parent.width, parent.height) - 8px;
        x: (parent.width - self.side) / 2;
        y: (parent.height - self.side) / 2;
        width: self.side;
        height: self.side;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.ticks-off;
            stroke: P.dim-tick;
            stroke-width: max(1.5px, parent.width / 140);
            stroke-line-cap: round;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.red-off;
            stroke: P.red.with-alpha(0.35);
            stroke-width: max(1.5px, parent.width / 140);
            stroke-line-cap: round;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.ticks-on;
            stroke: root.ink;
            stroke-width: max(1.5px, parent.width / 140);
            stroke-line-cap: round;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.red-on;
            stroke: P.red;
            stroke-width: max(1.5px, parent.width / 140);
            stroke-line-cap: round;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.needle;
            stroke: Theme.text;
            stroke-width: max(3px, parent.width / 70);
            stroke-line-cap: round;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: w.peak;
            stroke: Theme.primary;
            stroke-width: max(3px, parent.width / 70);
            stroke-line-cap: round;
        }
        for t in w.labels: Text {
            x: t.x * parent.width - 30px;
            y: t.y * parent.height - self.height / 2;
            width: 60px;
            horizontal-alignment: center;
            text: t.label;
            color: Theme.text-secondary;
            font-size: max(11px, parent.width / 22);
        }
        gv := Text {
            y: parent.height * 0.52 - self.height * 0.62;
            width: parent.width;
            horizontal-alignment: center;
            text: w.value;
            color: root.state-ink;
            font-size: min(parent.width * 0.19, parent.width * 0.62 / max(3, w.value.character-count) * 1.5);
        }
        Caption {
            u: root.u;
            y: gv.y + gv.height;
            width: parent.width;
            horizontal-alignment: center;
            text: w.unit == "" ? w.label : w.label + " · " + w.unit;
        }
        if w.sub != "": Text {
            y: parent.height * 0.84;
            width: parent.width;
            horizontal-alignment: center;
            text: w.sub;
            color: Theme.primary;
            font-size: max(11px, parent.width / 20);
            font-weight: 500;
            letter-spacing: 1px;
        }
    }

    // Bar: label and number, then LIVI's segmented bar.
    if w.style == 2: VerticalLayout {
        padding: 12 * root.u;
        alignment: center;
        spacing: 10 * root.u;
        HorizontalLayout {
            Caption { u: root.u; text: w.label; vertical-alignment: bottom; }
            Rectangle { horizontal-stretch: 1; }
            bn := Text {
                text: w.value;
                color: root.state-ink;
                font-size: min(parent.width / 5, 36 * root.u);
                vertical-alignment: bottom;
            }
            Text {
                text: " " + w.unit;
                color: P.label;
                font-size: max(12px, bn.font-size * 0.4);
                vertical-alignment: bottom;
            }
        }
        HorizontalLayout {
            height: max(8px, 10 * root.u);
            spacing: max(3px, 5 * root.u);
            for i in w.segs: Rectangle {
                border-radius: 3px;
                background: i >= w.lit ? P.dim-tick : (i >= w.limit-from ? P.red : (i >= w.warn-from ? P.amber : root.ink));
            }
        }
    }

    // Graph: legend, hairline grid, lines, marks.
    if w.style == 3: VerticalLayout {
        padding: 10 * root.u;
        spacing: 6 * root.u;
        HorizontalLayout {
            spacing: 16 * root.u;
            for l in w.lines: Text {
                text: l.label;
                color: l.color == 0 ? Theme.primary : (l.color == 1 ? Theme.text-secondary : P.amber);
                font-size: max(12px, 14 * root.u);
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        area := Rectangle {
            vertical-stretch: 1;
            for f in [0.25, 0.5, 0.75]: Rectangle {
                y: parent.height * f;
                height: 1px;
                background: P.hair;
            }
            for l in w.lines: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 1000;
                viewbox-height: 1000;
                fit: fill;
                commands: l.path;
                stroke: l.color == 0 ? Theme.primary : (l.color == 1 ? Theme.text-secondary : P.amber);
                stroke-width: l.color == 0 ? 3px : 2px;
                stroke-line-join: round;
                fill: transparent;
            }
            for m in w.marks: Rectangle {
                x: m.x * parent.width;
                width: 1px;
                background: Theme.text.with-alpha(0.45);
                Rectangle {
                    x: -10px;
                    y: 0;
                    width: 20px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.text.with-alpha(0.2);
                    Text {
                        text: m.label;
                        color: Theme.text;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // Pair: actual in teal, specified in white, the difference under.
    if w.style == 4: VerticalLayout {
        padding: 12 * root.u;
        alignment: center;
        spacing: 6 * root.u;
        Caption { u: root.u; text: w.label + "  /  " + w.label2; }
        HorizontalLayout {
            spacing: 18 * root.u;
            alignment: start;
            Text {
                text: w.value;
                color: w.stale ? Theme.text-disabled : Theme.primary;
                font-size: min(root.height * 0.42, (root.width - 60px) / max(4, w.value.character-count + w.value2.character-count) * 1.5);
            }
            Text {
                text: w.value2;
                color: root.ink;
                font-size: min(root.height * 0.42, (root.width - 60px) / max(4, w.value.character-count + w.value2.character-count) * 1.5);
            }
            Text {
                text: w.unit;
                color: P.label;
                font-size: max(13px, 16 * root.u);
                vertical-alignment: bottom;
            }
        }
        if w.sub != "": Text {
            text: w.sub;
            color: P.label;
            font-size: max(12px, 15 * root.u);
        }
    }

    // Set: wheels, cylinders, doors as small numbers with bars.
    if w.style == 5: VerticalLayout {
        padding: 12 * root.u;
        spacing: 8 * root.u;
        Caption { u: root.u; text: w.label; }
        HorizontalLayout {
            spacing: 12 * root.u;
            for it in w.items: VerticalLayout {
                spacing: 4 * root.u;
                alignment: end;
                Text {
                    text: it.label;
                    color: P.label;
                    font-size: max(11px, 13 * root.u);
                    horizontal-alignment: center;
                }
                Text {
                    text: it.value;
                    color: it.on ? P.amber : (it.state == 2 ? P.red : (it.state == 1 ? P.amber : root.ink));
                    font-size: max(14px, 26 * root.u);
                    horizontal-alignment: center;
                }
                if it.frac >= 0: Rectangle {
                    height: max(6px, 8 * root.u);
                    border-radius: 3px;
                    background: P.dim-tick;
                    Rectangle {
                        x: 0;
                        width: parent.width * it.frac;
                        border-radius: 3px;
                        background: it.state == 2 ? P.red : (it.state == 1 ? P.amber : root.ink);
                    }
                }
            }
        }
    }

    // Selector: P R N D S, the position lit; the big value for tiptronic gears.
    if w.style == 6: VerticalLayout {
        padding: 12 * root.u;
        alignment: center;
        spacing: 8 * root.u;
        Caption { u: root.u; text: w.label; horizontal-alignment: center; }
        HorizontalLayout {
            alignment: center;
            spacing: 14 * root.u;
            for it in w.items: Rectangle {
                width: sel.font-size * 1.25;
                height: sel.font-size * 1.3;
                border-radius: 8px;
                background: it.on ? Theme.highlight : transparent;
                sel := Text {
                    text: it.label;
                    color: it.on ? #ffffff : P.dim-tick.with-alpha(0.6);
                    font-size: min(root.height * 0.32, root.width / 9);
                    font-weight: it.on ? 700 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if w.value != "P" && w.value != "R" && w.value != "N" && w.value != "D" && w.value != "S": Text {
            text: w.value;
            color: root.ink;
            horizontal-alignment: center;
            font-size: max(14px, 24 * root.u);
        }
        Text {
            text: w.sub;
            color: Theme.primary;
            horizontal-alignment: center;
            font-size: max(11px, 13 * root.u);
            letter-spacing: 1.5px;
            font-weight: 500;
        }
    }

    TouchArea {
        clicked => { root.pushed(); }
    }
}

component PanelView inherits Rectangle {
    in property <int> focus-index;
    property <bool> edit: CarpiState.panel-edit;
    property <length> gap: root.edit ? 8px : 0;
    property <int> cols: max(1, CarpiState.panel-cols);
    property <int> rows: max(1, CarpiState.panel-rows);
    property <length> foot: CarpiState.panel-dots > 1 ? 22px : 0;
    property <length> cw: (root.width - (root.cols - 1) * root.gap) / root.cols;
    property <length> ch: (root.height - root.foot - (root.rows - 1) * root.gap) / root.rows;

    for e[i] in CarpiState.panel-empties: Rectangle {
        x: e.col * (root.cw + root.gap);
        y: e.row * (root.ch + root.gap);
        width: root.cw;
        height: root.ch;
        border-radius: 10px;
        border-width: root.focus-index == e.focus-at ? 3px : 1.5px;
        border-color: root.focus-index == e.focus-at ? Theme.primary : Theme.divider;
        Text {
            text: "+";
            color: root.focus-index == e.focus-at ? Theme.primary : Theme.text-disabled;
            font-size: 34px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { CarpiState.panel(CarpiState.panel-widgets.length + i); }
        }
    }
    for w[i] in CarpiState.panel-widgets: Rectangle {
        x: w.col * (root.cw + root.gap);
        y: w.row * (root.ch + root.gap);
        width: w.w * root.cw + (w.w - 1) * root.gap;
        height: w.h * root.ch + (w.h - 1) * root.gap;
        // Hairlines between widgets while viewing.
        if !root.edit && w.col > 0: Rectangle {
            x: 0;
            y: 10px;
            width: 1px;
            height: parent.height - 20px;
            background: P.hair;
        }
        if !root.edit && w.row > 0: Rectangle {
            x: 10px;
            y: 0;
            width: parent.width - 20px;
            height: 1px;
            background: P.hair;
        }
        WidgetView {
            w: w;
            edit: root.edit;
            focused: w.focus-at >= 0 && root.focus-index == w.focus-at;
            pushed => { CarpiState.panel(root.edit ? i : 0); }
        }
    }
    if CarpiState.panel-hint != "": Text {
        y: (root.height - root.foot - self.height) / 2;
        width: root.width;
        horizontal-alignment: center;
        text: CarpiState.panel-hint;
        color: Theme.text-disabled;
        font-size: 22px;
    }
    if CarpiState.panel-hint != "" && !root.edit: TouchArea {
        clicked => { CarpiState.panel(0); }
    }
    if root.foot > 0: Rectangle {
        y: root.height - 16px;
        x: (root.width - self.width) / 2;
        height: 16px;
        width: CarpiState.panel-dots * 15px + 14px;
        border-radius: 8px;
        background: Theme.text.with-alpha(0.08);
        HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            spacing: 7px;
            alignment: center;
            for d in CarpiState.panel-dots: Rectangle {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: d == CarpiState.panel-at ? Theme.primary : Theme.text.with-alpha(0.35);
            }
        }
    }
}

export component CarpiView inherits Rectangle {
    background: Theme.background;

    property <int> focus-index: Focus.zone == FocusZone.main ? Focus.main-index : -1;
    property <bool> has-grid: CarpiState.cells.length > 0;

    // Keeps the focused row in the middle third.
    changed focus-index => {
        if (CarpiState.layout != CarpiLayout.list || focus-index < 0 || focus-index >= CarpiState.spots.length) {
            return;
        }
        let s = CarpiState.spots[focus-index];
        if (s.line == -1) {
            return;
        }
        if (s.line >= 0) {
            flick.content-y = 0;
            return;
        }
        let top = (root.has-grid ? flick.height + M.gap : 0) + s.rows * M.row-h + s.sections * M.caption-h;
        let mid = top + M.row-h / 2 + flick.content-y;
        if (mid < flick.height / 3 || mid > flick.height * 2 / 3) {
            flick.content-y = clamp(flick.height / 2 - top - M.row-h / 2, min(0px, flick.height - list.preferred-height), 0px);
        }
    }

    VerticalLayout {
        padding-left: M.pad-x;
        padding-right: M.pad-x;
        padding-top: 8px;
        padding-bottom: 12px;
        spacing: 8px;

        Header { }

        if CarpiState.note != "": Text {
            text: CarpiState.note;
            color: Theme.text-secondary;
            font-size: M.small;
            overflow: elide;
        }

        body := Rectangle {
            vertical-stretch: 1;
            if CarpiState.plot-shown && CarpiState.layout == CarpiLayout.list: Plot {
                x: 0;
                width: parent.width * 0.44;
                height: parent.height;
            }
            if CarpiState.panel-shown && CarpiState.layout == CarpiLayout.list: PanelView {
                x: 0;
                width: parent.width * 0.5;
                height: parent.height;
                focus-index: -1;
            }
            flick := Flickable {
                x: CarpiState.plot-shown ? parent.width * 0.44 + 10px : (CarpiState.panel-shown ? parent.width * 0.5 + 10px : 0);
                width: parent.width - self.x;
                height: parent.height;
                visible: CarpiState.layout == CarpiLayout.list;
                content-height: list.preferred-height;
                list := VerticalLayout {
                    width: parent.width;
                    if root.has-grid: VerticalLayout {
                        height: flick.height + M.gap;
                        padding-bottom: M.gap;
                        Grid {
                            focus-index: root.focus-index;
                        }
                    }
                    for r[i] in CarpiState.rows: Rectangle {
                        height: r.kind == CarpiKind.section ? M.caption-h : M.row-h;
                        if r.kind == CarpiKind.section: Text {
                            x: 18px;
                            y: parent.height - self.height - 6px;
                            text: r.label;
                            color: Theme.primary;
                            font-size: M.small;
                            font-weight: 700;
                        }
                        if r.kind != CarpiKind.section: RowView {
                            width: parent.width;
                            height: parent.height;
                            r: r;
                            focused: root.focus-index == r.focus-at;
                            pushed => { CarpiState.row(i); }
                        }
                    }
                }
            }
            if CarpiState.layout == CarpiLayout.grid: Grid {
                width: parent.width;
                height: parent.height;
                focus-index: root.focus-index;
            }
            if CarpiState.layout == CarpiLayout.panel: PanelView {
                width: parent.width;
                height: parent.height;
                focus-index: root.focus-index;
            }
        }
    }
}

// Over everything, AA and CarPlay included: a short line from carpid or the pages.
export component CarpiToastView inherits Rectangle {
    in property <length> window-width;
    width: min(row.preferred-width, root.window-width - 48px);
    height: row.preferred-height;
    background: #141416eb;
    border-radius: 14px;
    border-width: 1px;
    border-color: #ffffff2e;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000066;
    opacity: CarpiToast.shown ? 1 : 0;
    animate opacity { duration: CarpiToast.shown ? 160ms : 300ms; easing: ease-in-out; }

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: 24px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 14px;
        Rectangle {
            width: 6px;
            border-radius: 3px;
            background: CarpiToast.level == 2 ? #ff6b6b : (CarpiToast.level == 1 ? #ffb74d : #26c6c6);
        }
        Text {
            text: CarpiToast.text;
            color: #ffffff;
            font-size: 24px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// ---- On-screen keyboard (docs/PAGES.md 5b) ----

// kind: 0 a character, 1 a control key, 2 the action (Join, Save).
export struct CarpiKey {
    label: string,
    span: int,
    kind: int,
}

export struct CarpiKeyRow {
    keys: [CarpiKey],
}

export global CarpiKeyboard {
    in property <bool> shown;
    in property <bool> touch;
    in property <string> title;
    // The field around the cursor, as shown (dots for a hidden password).
    in property <string> before;
    in property <string> after;
    in property <int> count;
    in property <[CarpiKeyRow]> rows;
    // The lit key on the knob keyboard; -1 on the touch one.
    in property <int> focus-row: -1;
    in property <int> focus-key: -1;
    callback tap(int, int);
}

export component CarpiKeyboardView inherits Rectangle {
    background: Theme.background;
    // Swallow taps that miss a key, so nothing under the sheet reacts.
    TouchArea { }

    VerticalLayout {
        padding: 14px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: CarpiKeyboard.title;
                color: Theme.text-secondary;
                font-size: 18px;
                horizontal-stretch: 1;
            }
            Text {
                text: CarpiKeyboard.count == 1 ? "1 character" : CarpiKeyboard.count + " characters";
                color: Theme.text-disabled;
                font-size: 16px;
            }
        }
        Rectangle {
            height: 54px;
            background: Theme.paper;
            border-radius: 10px;
            border-width: 2px;
            border-color: Theme.primary;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: start;
                Text {
                    text: CarpiKeyboard.before;
                    color: Theme.text;
                    font-size: 26px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 3px;
                        height: 30px;
                        background: Theme.primary;
                    }
                }
                Text {
                    text: CarpiKeyboard.after;
                    color: Theme.text;
                    font-size: 26px;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        for row[r] in CarpiKeyboard.rows: HorizontalLayout {
            spacing: 6px;
            height: CarpiKeyboard.touch ? 66px : 58px;
            for key[k] in row.keys: Rectangle {
                horizontal-stretch: key.span;
                property <bool> lit: r == CarpiKeyboard.focus-row && k == CarpiKeyboard.focus-key;
                border-radius: 8px;
                background: key.kind == 2 ? Theme.primary
                    : (key.kind == 1 ? Theme.paper.mix(Theme.text, 0.86) : Theme.paper);
                border-width: lit ? 3px : 0px;
                border-color: Theme.highlight;
                Rectangle {
                    // The lit key's fill, under the label.
                    visible: lit;
                    border-radius: 8px;
                    background: Theme.primary.with-alpha(0.25);
                }
                Text {
                    text: key.label;
                    color: key.kind == 2 ? #ffffff : Theme.text;
                    font-size: key.kind == 0 ? 24px : 18px;
                    font-weight: lit ? 700 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => { CarpiKeyboard.tap(r, k); }
                }
            }
        }
        Text {
            visible: !CarpiKeyboard.touch;
            text: "Turn to move · Up/Down change row · Push types · Prev/Next held move the cursor · Return deletes, held closes";
            color: Theme.text-disabled;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}
